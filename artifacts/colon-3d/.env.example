# Colón 3D - Environment Variables
# Copy this file to .env.local and fill in your API keys

# OpenWeatherMap API key (optional, free tier available)
# Get yours at: https://openweathermap.org/api
# If omitted, the app falls back automatically to Open-Meteo (no key required)
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Base path for the application
BASE_PATH=/

# Optional API base URL (used for hydrology proxy endpoint)
# Example local: http://localhost:5180
VITE_API_BASE_URL=

# Server port (also set in shell: $env:PORT=5180)
VITE_PORT=5180
