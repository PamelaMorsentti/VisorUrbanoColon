{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --parallel --stream --filter @workspace/api-server --filter @workspace/colon-3d run dev",
    "dev:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/colon-3d run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/colon-3d run build",
    "build:netlify": "pnpm run build:web",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "docs:fichas-src": "pnpm --filter @workspace/scripts run docs:fichas-src",
    "build:zonas-tributarias": "pnpm --filter @workspace/scripts run build:zonas-tributarias",
    "maint:archive-temp": "pnpm --filter @workspace/scripts run maint:archive-temp",
    "maint:archive-temp:dry": "pnpm --filter @workspace/scripts run maint:archive-temp:dry",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ]
}
